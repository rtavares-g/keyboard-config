[Unit]
Description=Sobe a janela em foco quando o teclado virtual abre
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 %h/projetos/keyboard-config/espaco/teclado-espaco.py
Environment=WAYLAND_DISPLAY=wayland-0
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
